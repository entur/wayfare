# Runtime mode
# - dev: OMSA + Sales in dev, uses dev credentials
# - staging: OMSA + Sales in staging, uses staging credentials
# - local-dev: OMSA on localhost, Sales/OAuth/Audience use dev defaults
# - local-staging: OMSA on localhost, Sales/OAuth/Audience use staging defaults
OMSA_ENV_MODE=dev

# Whether a client-supplied cookie (the Settings > Developer tab / EnvToggle)
# may override the mode above, plus Entur headers and recommendation-control
# tweaks. Leave unset/true for local development. A published deployment
# (e.g. the tst environment behind the Entur employee login) MUST set this to
# false, so OMSA_ENV_MODE is the only mode that can ever be active and the
# localhost-pointing local-dev/local-staging modes are unreachable.
# ALLOW_DEV_CONFIG_OVERRIDES=false

# Entur employee login (see src/server/access-gate.ts). Gates every request
# behind a login screen for Entur/partner-tenant identities, using Authorization
# Code with PKCE and an HttpOnly session cookie. This only takes effect in the
# built server (server.mjs), never under `pnpm dev`. A published deployment
# (tst) sets this to true; leave unset/false everywhere else, including local
# development.
# REQUIRE_ENTUR_LOGIN=true

# The confidential Regular Web Application registered against
# ENTUR_LOGIN_DOMAIN. It is requested separately from the internal M2M client.
# Store the secret in Secret Manager. Both are required when login is enabled.
# ENTUR_LOGIN_CLIENT_ID=
# ENTUR_LOGIN_CLIENT_SECRET=

# Defaults to partner.staging.entur.org / partner.dev.entur.org based on
# OMSA_ENV_MODE. Override only if the login tenant needs to differ from the
# OMSA one.
# ENTUR_LOGIN_DOMAIN=

# Canonical public origin for callbacks, redirects, and logout. It must use
# HTTPS and contain only the scheme and host.
# PUBLIC_ORIGIN=https://wayfare.staging.entur.no

# Whether cookies set by the login flow require HTTPS. This must be true when
# login is enabled.
# COOKIE_SECURE=true

# Permission Store authorization on top of login (see
# src/server/permission-store.ts) — restricts access to accounts granted the
# wayfare.web business capability, rather than any Entur/partner identity that
# can complete login. Every value is required when login is enabled. The M2M
# credentials come from the .entur/ GoogleCloudApplication manifest's
# auth0.internal block and are exposed through Secret Manager after it is
# applied.
# PERMISSION_STORE_URL=
# MNG_AUTH0_INT_HOST=
# MNG_AUTH0_INT_AUDIENCE=
# MNG_AUTH0_INT_CLIENT_ID=
# MNG_AUTH0_INT_CLIENT_SECRET=

# Per-env field hierarchy
# Every field below supports mode-specific prefixes. Resolution order, most specific first:
#   local-dev:     LOCAL_DEV_{FIELD} → DEV_{FIELD}     → {FIELD}
#   local-staging: LOCAL_STAGING_{FIELD} → STAGING_{FIELD} → {FIELD}
#   dev:           DEV_{FIELD} → {FIELD}
#   staging:       STAGING_{FIELD} → {FIELD}
#
# Examples:
#   STAGING_CLIENT_ID applies to both staging and local-staging (unless LOCAL_STAGING_CLIENT_ID is set).
#   CLIENT_ID is the universal fallback used when no prefixed value is found.

# Endpoint overrides (leave unset to use mode defaults)
# OMSA_BASE_URL=
# STAGING_OMSA_BASE_URL=
# LOCAL_STAGING_OMSA_BASE_URL=
# SALES_BASE_URL=
# JOURNEY_PLANNER_URL=
# GEOCODER_URL=
# OAUTH_TOKEN_URL=
# AUTH0_AUDIENCE=

# OAuth credentials
CLIENT_ID=
CLIENT_SECRET=
# STAGING_CLIENT_ID=
# STAGING_CLIENT_SECRET=

# Entur headers
ENTUR_DISTRIBUTION_CHANNEL=WAY:DistributionChannel:App
ENTUR_CLIENT_NAME=Wayfare-Web
ENTUR_POS=Wayfare
# STAGING_ENTUR_DISTRIBUTION_CHANNEL=
# STAGING_ENTUR_POS=

# Vipps
# VIPPS_PHONE_NUMBER=
# STAGING_VIPPS_PHONE_NUMBER=

# Server-side request/response logging in pnpm dev terminal (true|false).
# Defaults to true in non-production when unset.
ENABLE_REQUEST_RESPONSE_LOGGING=true

# Logging detail level: meta | headers | body
# - meta: method/url/status/duration only
# - headers: meta + request/response headers
# - body: headers + request/response bodies
# Defaults to body when unset.
REQUEST_RESPONSE_LOG_LEVEL=body

# Log output format: pretty | json
# - pretty: multi-line human-readable (util.inspect), current default
# - json: one JSON object per line (ndjson), easy to grep/less/jq or pipe to a file
# Defaults to pretty when unset.
REQUEST_RESPONSE_LOG_FORMAT=pretty

# Object print depth for logged payloads. Use full/null for unlimited depth, or a number like 2.
# Defaults to full depth when unset.
REQUEST_RESPONSE_LOG_DEPTH=full

# Redact sensitive headers (Authorization / Proxy-Authorization) in terminal logs.
# Defaults to true. Set to false only when you explicitly need raw values.
REQUEST_RESPONSE_LOG_REDACT_SENSITIVE_HEADERS=true
