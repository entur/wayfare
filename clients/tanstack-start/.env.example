# Runtime modes: dev, staging, local-dev, local-staging
OMSA_ENV_MODE=dev

# Set to false in deployed environments.
# ALLOW_DEV_CONFIG_OVERRIDES=false

# Published login gate (server.mjs only)
# REQUIRE_ENTUR_LOGIN=true
# PUBLIC_ORIGIN=https://wayfare.staging.entur.no
# ENTUR_LOGIN_DOMAIN=partner.staging.entur.org
# ENTUR_LOGIN_CLIENT_ID=
# ENTUR_LOGIN_CLIENT_SECRET=
# COOKIE_SECURE=true

# Permission Store (required with the login gate)
# PERMISSION_STORE_URL=
# MNG_AUTH0_INT_HOST=
# MNG_AUTH0_INT_AUDIENCE=
# MNG_AUTH0_INT_CLIENT_ID=
# MNG_AUTH0_INT_CLIENT_SECRET=

# Per-mode overrides. Local modes fall back to their remote environment.
#   local-dev:     LOCAL_DEV_{FIELD} → DEV_{FIELD}     → {FIELD}
#   local-staging: LOCAL_STAGING_{FIELD} → STAGING_{FIELD} → {FIELD}
#   dev:           DEV_{FIELD} → {FIELD}
#   staging:       STAGING_{FIELD} → {FIELD}

# Endpoint overrides
# OMSA_BASE_URL=
# STAGING_OMSA_BASE_URL=
# LOCAL_STAGING_OMSA_BASE_URL=
# SALES_BASE_URL=
# JOURNEY_PLANNER_URL=
# GEOCODER_URL=
# OAUTH_TOKEN_URL=
# AUTH0_AUDIENCE=

# OAuth credentials
CLIENT_ID=
CLIENT_SECRET=
# STAGING_CLIENT_ID=
# STAGING_CLIENT_SECRET=

# Entur headers
ENTUR_DISTRIBUTION_CHANNEL=WAY:DistributionChannel:App
ENTUR_CLIENT_NAME=Wayfare-Web
ENTUR_POS=Wayfare
# STAGING_ENTUR_DISTRIBUTION_CHANNEL=
# STAGING_ENTUR_POS=

# Vipps
# VIPPS_PHONE_NUMBER=
# STAGING_VIPPS_PHONE_NUMBER=

# Request logging
ENABLE_REQUEST_RESPONSE_LOGGING=true

# meta | headers | body
REQUEST_RESPONSE_LOG_LEVEL=body

# pretty | json
REQUEST_RESPONSE_LOG_FORMAT=pretty

# full, null, or a number
REQUEST_RESPONSE_LOG_DEPTH=full

REQUEST_RESPONSE_LOG_REDACT_SENSITIVE_HEADERS=true
