    "@entur/layout": "3.7.5",
    "@entur/loader": "0.8.3",
    "@entur/tokens": "3.24.0",
    "@entur/tooltip": "5.3.16",
    "@entur/travel": "7.0.4",
    "@entur/typography": "2.1.12",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.31",
