    "lucide-react": "1.31.0",
    "maplibre-gl": "6.0.0",
    "openid-client": "6.8.7",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "srvx": "0.12.5",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
