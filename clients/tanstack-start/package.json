{
  "name": "tanstack-start",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:log": "mkdir -p logs && REQUEST_RESPONSE_LOG_FORMAT=json vite dev --port 3000 2>&1 | tee logs/dev.log",
    "build": "vite build",
    "start": "node server.mjs",
    "preprocess-stops": "node scripts/preprocess-stops.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run --passWithNoTests",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check"
  },
  "dependencies": {
    "@auth0/auth0-server-js": "1.13.0",
    "@entur-partner/permission-client-node": "3.6.2",
    "@entur/button": "5.0.5",
    "@entur/form": "10.1.2",
    "@entur/icons": "10.0.6",
    "@entur/layout": "4.0.5",
    "@entur/loader": "0.8.7",
    "@entur/tokens": "4.1.1",
    "@entur/tooltip": "6.0.7",
    "@entur/travel": "8.0.7",
    "@entur/typography": "3.0.7",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.56",
    "@tanstack/router-core": "1.171.32",
    "@tanstack/router-plugin": "1.168.40",
    "@types/qrcode": "1.5.6",
    "lucide-react": "1.46.0",
    "maplibre-gl": "6.9.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "srvx": "0.12.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-query-devtools": "5.102.8",
    "@tanstack/react-router-devtools": "1.167.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=11.0.0"
  }
